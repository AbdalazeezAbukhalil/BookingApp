{
  "expo": {
    "name": "Booking",
    "slug": "Booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/HD-wallpaper-navigation-travel-love-nature-traveling-thumbnail.jpg",
    "scheme": "booking",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/HD-wallpaper-navigation-travel-love-nature-traveling-thumbnail.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#1e4d2b",
      "dark": {
        "backgroundColor": "#1e4d2b"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e4d2b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/HD-wallpaper-navigation-travel-love-nature-traveling-thumbnail.jpg",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#1e4d2b",
          "dark": {
            "backgroundColor": "#1e4d2b"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
